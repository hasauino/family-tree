# Don't add spaces before and after "=".
# This file will be sourced by the cron job that backs up the DB.
# It should have a valid format to do: source .env
SITE_NAME="Omari Tree"
DOMAIN_NAME="server.omaritree.com"
LANGUAGE_CODE="en"

# Host port the Django backend (behind its nginx) is published on. The
# server's reverse proxy forwards server.omaritree.com here.
PORT="9000"

# Host port the Flutter web app (built into its own nginx image) is published
# on. The server's reverse proxy forwards omaritree.com here.
WEB_PORT="9002"

# Public URL of the backend. Baked into the Flutter web build as
# API_BASE_URL, and used for CORS/CSRF below.
BACKEND_URL="http://localhost:9000"

# Public URL of the Flutter web app. Allowed to call the backend's GraphQL
# API cross-origin (see CORS_ALLOWED_ORIGINS / CSRF_TRUSTED_ORIGINS).
FRONTEND_URL="http://localhost:9002"

DJANGO_SETTINGS_MODULE="project.settings.production"

# Change database. Useful during development (use db.sqlite3 in production)
DATABASE="dummy_db.sqlite3"

# Change this for security. Online generator: https://djecrety.ir/
SECRET_KEY='t_!7jkj6-vm=@z3hsz9tk-+u3bdk_nvi7mr^dyfk&$s)z-!ar1'

# Email (Resend). Sign up at resend.com, verify the sending domain, then put the
# API key here. The "from" address must belong to a verified domain.
RESEND_API_KEY="re_jfpn7j5S_PTYqybYFt9QBWn1TbBxfxyEF"
DEFAULT_FROM_EMAIL="noreply@omaritree.com"

# --- Sign-in / sign-up methods ------------------------------------------
# Each method is independently switchable. A social provider only shows up in
# the app once it is enabled AND its credentials below are filled in.

# Email + password (on by default).
AUTH_EMAIL_ENABLED="True"
# "True" = send an activation email on sign-up; "False" = activate instantly.
AUTH_EMAIL_REQUIRE_ACTIVATION="True"

# Google. GOOGLE_CLIENT_IDS = comma-separated OAuth client ids that may sign in
# (the iOS, Android and/or web client ids from Google Cloud Console).
AUTH_GOOGLE_ENABLED="False"
GOOGLE_CLIENT_IDS=""

# Apple. APPLE_CLIENT_IDS = comma-separated bundle id and/or services id.
AUTH_APPLE_ENABLED="False"
APPLE_CLIENT_IDS=""

# Facebook app credentials (from developers.facebook.com).
AUTH_FACEBOOK_ENABLED="False"
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""
